{
    "name": "atd-linker",
    "displayName": "ATD Linker",
    "version": "1.0.2",
    "publisher": "local-dev",
    "engines": {
        "vscode": "^1.60.0"
    },
    "activationEvents": [
        "workspaceContains:.atd"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "atd.showFullGraph",
                "title": "ATD: Show Full System Graph",
                "category": "ATD"
            },
            {
                "command": "atd.renameAtom",
                "title": "ATD: Rename Atom",
                "category": "ATD"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "atd-explorer",
                    "title": "ATD",
                    "icon": "$(type-hierarchy)"
                }
            ]
        },
        "views": {
            "atd-explorer": [
                {
                    "id": "atdGraphExplorer",
                    "name": "ATD Graph Explorer",
                    "type": "tree",
                    "icon": "type-hierarchy"
                }
            ]
        },
        "configuration": {
            "title": "ATD Linker",
            "properties": {
                "atd.autoShowGraph": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically show the ATD graph when opening an .atom.md file."
                }
            }
        }
    }
}