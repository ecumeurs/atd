{
    "name": "atd-linker",
    "displayName": "ATD Linker",
    "version": "1.0.0",
    "description": "ATD documentation management for VS Code",
    "engines": {
        "vscode": "^1.60.0"
    },
    "activationEvents": [
        "workspaceContains:.atd",
        "workspaceContains:.atd.workspace"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "atd.showFullGraph",
                "title": "ATD: Show Full System Graph",
                "category": "ATD"
            },
            {
                "command": "atd.renameAtom",
                "title": "ATD: Rename Atom",
                "category": "ATD"
            },
            {
                "command": "atd.switchProject",
                "title": "ATD: Switch Active Project",
                "category": "ATD"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "atd-explorer",
                    "title": "ATD",
                    "icon": "$(type-hierarchy)"
                }
            ]
        },
        "views": {
            "atd-explorer": [
                {
                    "id": "atdGraphExplorer",
                    "name": "ATD Graph Explorer",
                    "type": "tree",
                    "icon": "type-hierarchy"
                }
            ]
        },
        "configuration": {
            "title": "ATD Linker",
            "properties": {
                "atd.autoShowGraph": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically show the ATD graph when opening an .atom.md file."
                }
            }
        }
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "@types/mocha": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.50.0",
        "mocha": "^10.2.0",
        "typescript": "^5.2.0",
        "esbuild": "^0.19.0"
    },
    "dependencies": {
        "vis-network": "^9.1.0"
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint extension.js --ext .js",
        "test": "mocha",
        "package": "vsce package"
    }
}